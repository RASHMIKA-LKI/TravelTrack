rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profiles ──────────────────────────────────────────────────────────
    // Users can only read/write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ─── Trip History (sub-collection) ──────────────────────────────────────
      // Users can only read/write their own trip records.
      match /trips/{tripId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Default deny ─────────────────────────────────────────────────────────
    // Everything else is blocked by default (Firestore denies any path
    // that doesn't match a rule above).
  }
}
